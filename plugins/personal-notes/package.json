{
  "name": "@local/personal-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e:sticky": "node e2e/stickycheck.mjs",
    "e2e:mynotes": "node e2e/mynotescheck.mjs",
    "e2e:node": "node e2e/nodecheck.mjs",
    "e2e:p2": "node e2e/p2check.mjs",
    "e2e:mobile": "node e2e/mobilecheck.mjs",
    "e2e:fix": "node e2e/fixcheck.mjs",
    "e2e:regress": "node e2e/regress.mjs",
    "e2e:ui": "node e2e/uicheck.mjs",
    "e2e:tour": "node e2e/tourcheck.mjs",
    "e2e:exp": "node e2e/expcheck.mjs",
    "e2e:sw": "node e2e/swcheck.mjs",
    "e2e:tutorial": "node e2e/tutorialcheck.mjs",
    "e2e:help": "node e2e/helpcheck.mjs",
    "e2e:smoke": "node e2e/smoke.mjs"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "dependencies": {
    "@quartz-community/types": "github:quartz-community/types",
    "preact": "^10.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "fake-indexeddb": "^6.0.0",
    "sass": "^1.103.1",
    "tsup": "^8.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "quartz": {
    "name": "personal-notes",
    "displayName": "Personal Notes",
    "category": [
      "emitter",
      "pageType",
      "component"
    ],
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": false,
    "defaultOptions": {
      "clientId": "",
      "syncEnabled": true,
      "minPollSeconds": 180,
      "maxWritesPerMinute": 6,
      "notice": ""
    },
    "components": {
      "PersonalNotes": {
        "displayName": "Personal Notes",
        "defaultPosition": "afterBody",
        "defaultPriority": 20
      }
    }
  }
}
