{
  "name": "numbers-journey",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "民數記 33 章曠野四十二站的互動旅程地圖（非商業教育用途）",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3043",
    "build": "npm run verify && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4195",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test",
    "verses": "node scripts/build-verses.mjs",
    "places": "node scripts/build-places.mjs",
    "geodata": "node scripts/build-geodata.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "rollup": "4.62.4"
  }
}
